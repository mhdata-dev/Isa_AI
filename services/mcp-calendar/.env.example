# Copiar para .env neste diretório e preencher fora do Git.
MICROSOFT_CLIENT_ID=replace-me
MICROSOFT_CLIENT_SECRET=replace-me
MICROSOFT_TENANT_ID=consumers
MICROSOFT_REDIRECT_URI=https://isa.example.com/oauth/microsoft/callback
# Chave Fernet, gerada pelo operador; não usar este placeholder.
CALENDAR_ENCRYPTION_KEY=replace-me-with-a-fernet-key
CALENDAR_DB_PATH=/data/calendar.db
PERSONAL_EMAIL=
WORK_EMAIL=
CONSULTING_EMAIL=
